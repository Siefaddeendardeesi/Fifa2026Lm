# Environment configuration — copy to .env and customize
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO
LOG_JSON=false
RANDOM_SEED=42

# MLflow
MLFLOW_TRACKING_URI=file:./mlruns
MLFLOW_REGISTRY_URI=file:./mlruns
MLFLOW_EXPERIMENT_NAME=fifa2026-match-outcome
CHAMPION_MODEL_NAME=champion

# API
API_HOST=0.0.0.0
API_PORT=8000
API_RATE_LIMIT=100/minute

# Database (Docker Compose — use strong passwords in production)
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=fifa2026
POSTGRES_PASSWORD=change-me-use-strong-password
POSTGRES_DB=fifa2026

# Grafana (Docker Compose)
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-use-strong-password
GRAFANA_PORT=3000

# External APIs (never commit real credentials)
KAGGLE_USERNAME=
KAGGLE_KEY=
APIFY_TOKEN=

# DVC (install with: pip install -e ".[pipeline]")
DVC_REMOTE=localstorage
DVC_REMOTE_URL=./dvc-storage

# Simulation
SIMULATION_WORKERS=4

# Docker Compose port mappings (see docker/.env.example for full list)
DASHBOARD_PORT=8501
MLFLOW_PORT=5000
PROMETHEUS_PORT=9090
NGINX_PORT=80
