# Docker Compose environment — copy to docker/.env and customize.
# Never commit docker/.env with real secrets.

# Application
ENVIRONMENT=production

# PostgreSQL
POSTGRES_USER=fifa2026
POSTGRES_PASSWORD=change-me-use-strong-password
POSTGRES_DB=fifa2026
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# MLflow
MLFLOW_TRACKING_URI=http://mlflow:5000
MLFLOW_REGISTRY_URI=http://mlflow:5000
MLFLOW_EXPERIMENT_NAME=fifa2026-match-outcome
CHAMPION_MODEL_NAME=champion

# Grafana
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-use-strong-password

# API / Dashboard / Frontend ports (host mapping)
API_PORT=8000
DASHBOARD_PORT=8501
FRONTEND_PORT=3000
MLFLOW_PORT=5000
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001
NGINX_PORT=8080

# Frontend API URL (browser-facing; baked in at Docker build time)
NEXT_PUBLIC_API_URL=http://localhost:8000

# Optional external API credentials (leave empty for local)
KAGGLE_USERNAME=
KAGGLE_KEY=
APIFY_TOKEN=
