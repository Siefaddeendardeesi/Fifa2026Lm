# Production Environment Variables for Backend (FastAPI)
# Copy to Railway Dashboard → Backend Service → Variables
# Or use: railway set VAR_NAME=value

# Application
ENVIRONMENT=production

# PostgreSQL Connection (Railway auto-provides)
# Replace with actual Railway PostgreSQL URL
POSTGRES_HOST=postgres.railway.internal
POSTGRES_PORT=5432
POSTGRES_USER=fifa2026
POSTGRES_PASSWORD=change-me
POSTGRES_DB=fifa2026

# API Configuration
API_TITLE=FIFA 2026 Prediction Platform
API_VERSION=1.0.0
API_DESCRIPTION=Production-grade ML platform for FIFA World Cup 2026 prediction

# MLflow (disable for now, can add later)
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_REGISTRY_URI=http://localhost:5000
MLFLOW_EXPERIMENT_NAME=fifa2026-match-outcome
CHAMPION_MODEL_NAME=champion

# Security
CORS_ORIGINS=https://frontend-url.railway.app,https://yourdomain.com
SECRET_KEY=your-secret-key-here-change-this

# Optional: External APIs
KAGGLE_USERNAME=
KAGGLE_KEY=
APIFY_TOKEN=

# Logging
LOG_LEVEL=info
