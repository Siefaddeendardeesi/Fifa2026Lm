# Production Environment Variables for Frontend (Next.js)
# Copy to Railway Dashboard → Frontend Service → Variables
# Set NEXT_PUBLIC_API_URL at build time via build arguments

# Backend API URL (PUBLIC, browser-facing)
# Replace with your actual backend Railway URL
NEXT_PUBLIC_API_URL=https://backend-service.railway.app

# Next.js Configuration
NODE_ENV=production
NEXT_TELEMETRY_DISABLED=1
PORT=3000
HOSTNAME=0.0.0.0

# Optional analytics
NEXT_PUBLIC_GA_ID=
